# Copy to .env and fill in only the services you use.

WATSONX_API_KEY=your-watsonx-api-key
WATSONX_PROJECT_ID=your-project-id
WATSONX_URL=https://ca-tor.ml.cloud.ibm.com
# Override these if your watsonx region/project does not support the defaults.
WATSONX_VISION_MODEL=meta-llama/llama-3-2-11b-vision-instruct
WATSONX_TEXT_MODEL=meta-llama/llama-3-3-70b-instruct

# Optional: voice transcription
SPEECHMATICS_API_KEY=your-speechmatics-api-key

# Optional: Google Gemini API helper
GOOGLE_API_KEY=your-google-api-key
GOOGLE_MODEL=gemini-2.0-flash

# Optional: Cloudflare R2 (S3-compatible)
CLOUDFLARE_R2_ENDPOINT=https://your-account-id.r2.cloudflarestorage.com
CLOUDFLARE_R2_REGION=auto
CLOUDFLARE_R2_ACCESS_KEY_ID=your-r2-access-key-id
CLOUDFLARE_R2_SECRET_ACCESS_KEY=your-r2-secret-access-key
CLOUDFLARE_R2_BUCKET=your-bucket-name
