# Copy to Streamlit Cloud → Settings → Secrets (paste TOML there).
# Do NOT commit secrets.toml with real keys.

[watsonx]
api_key = "your-watsonx-api-key"
project_id = "your-project-id"
url = "https://ca-tor.ml.cloud.ibm.com"

# Optional: FastAPI backend URL when deployed separately
[app]
api_base_url = "http://localhost:8000"
